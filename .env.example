# Copy to .env and adjust. Never commit .env.
# Local dev Postgres (see AGENTS.md "Build & verify" for one-time setup):
DATABASE_URL="postgresql://tfa:tfa@localhost:5432/tfa_quickbooks"

# signs login sessions — any long random string; rotating it signs everyone out
SESSION_SECRET="change-me-to-something-long-and-random"
# optional: real email delivery for sign-in links (resend.com API key).
# Unset = links are printed to the server log instead.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="TFA Books <books@yourdomain.com>"
