generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id               String            @id @default(cuid())
  name             String            @unique
  type             AccountType
  active           Boolean           @default(true)
  cash             Boolean           @default(false) // bank/cash asset: statements import here; drives the cash-flow statement
  createdAt        DateTime          @default(now())
  lines            JournalLine[]
  bankTransactions BankTransaction[] @relation("BankAccountTransactions")
}

// A raw row from an imported bank statement. Uncategorized until it gets a
// journal entry; the journal entry is what actually hits the ledger.
model BankTransaction {
  id             String        @id @default(cuid())
  bankAccountId  String
  bankAccount    Account       @relation("BankAccountTransactions", fields: [bankAccountId], references: [id])
  date           DateTime
  description    String
  amountCents    Int // signed: positive = money in, negative = money out
  excluded       Boolean       @default(false) // hidden from review, never posted; still dedupes re-uploads
  importHash     String        @unique // dedupe key across re-uploads
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  // Mirror side of a transfer: this statement row is explained by an entry
  // posted from the other account's statement. Deleting the entry (undo)
  // un-matches the row automatically.
  matchedEntryId String?
  matchedEntry   JournalEntry? @relation("MatchedTransfers", fields: [matchedEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

model JournalEntry {
  id              String           @id @default(cuid())
  date            DateTime
  memo            String
  lines            JournalLine[]
  bankTransaction  BankTransaction?
  matchedTransfers BankTransaction[] @relation("MatchedTransfers")
  createdAt        DateTime          @default(now())
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
}

// Passwordless auth: only these emails may request sign-in links.
model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Single-use magic-link tokens; only the SHA-256 hash is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
